{
  // Les tests de bout en bout sont exclus du tsconfig principal : `next build`
  // typerait sinon tout le dossier, ce qui couple la compilation de
  // l'application au code de test et allonge chaque build. Ils restent
  // vérifiés, mais à part — inclus dans `npm run typecheck`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "types": ["node"]
  },
  // `next-env.d.ts` : les types des imports d'images (`*.png`) — certains
  // tests importent le registre des blocs, qui rend le logo du site.
  "include": ["e2e/**/*.ts", "playwright.config.ts", "next-env.d.ts"],
  "exclude": ["node_modules"]
}
